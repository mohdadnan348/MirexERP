# ==========================================
# APPLICATION CONFIGURATION
# ==========================================

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

APP_NAME=MirexERP
APP_URL=http://localhost:5000

# ==========================================
# DATABASE CONFIGURATION
# ==========================================

MONGODB_URI=mongodb://127.0.0.1:27017/mirexerp

# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/mirexerp?retryWrites=true&w=majority

# ==========================================
# FRONTEND CONFIGURATION
# ==========================================

FRONTEND_URL=http://localhost:3000
MOBILE_APP_SCHEME=mirexerp

# ==========================================
# JWT AUTHENTICATION
# ==========================================

JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# PASSWORD CONFIGURATION
# ==========================================

BCRYPT_SALT_ROUNDS=12

# ==========================================
# FILE UPLOAD CONFIGURATION
# ==========================================

UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Allowed file types
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# ==========================================
# RATE LIMIT CONFIGURATION
# ==========================================

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================
# PAGINATION CONFIGURATION
# ==========================================

DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# ==========================================
# LOGGING
# ==========================================

LOG_LEVEL=debug

# ==========================================
# EMAIL CONFIGURATION
# ==========================================

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=MirexERP
SMTP_FROM_EMAIL=

# ==========================================
# PAYMENT GATEWAY
# ==========================================

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ==========================================
# PUSH NOTIFICATIONS
# ==========================================

EXPO_ACCESS_TOKEN=

# ==========================================
# INITIAL SUPER ADMIN SEED
# ==========================================

SEED_SUPER_ADMIN_NAME=MirexERP Super Admin
SEED_SUPER_ADMIN_EMAIL=admin@mirexerp.com
SEED_SUPER_ADMIN_PASSWORD=ChangeThisToAStrongPassword123!
# Optional generic admission notification provider adapter
ADMISSION_NOTIFICATION_PROVIDER_URL=
ADMISSION_NOTIFICATION_API_TOKEN=
ADMISSION_NOTIFICATION_CHANNEL=SMS
